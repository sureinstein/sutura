{
  "info":{"name":"Sutura API — MVP","description":"Parcours nominal de l'API Flask Sutura. Lancer dans l'ordre avec l'environnement Sutura local.","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "item":[
    {"name":"01 — Santé","request":{"method":"GET","url":"{{baseUrl}}/health"},"event":[{"listen":"test","script":{"exec":["pm.test('API disponible', () => pm.response.to.have.status(200));","pm.test('Statut ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"],"type":"text/javascript"}}]},
    {"name":"02 — Demander OTP","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"telephone\":\"{{telephone}}\"}"},"url":"{{baseUrl}}/api/auth/request-otp"},"event":[{"listen":"test","script":{"exec":["pm.test('OTP demandé', () => pm.response.to.have.status(201));","const j=pm.response.json(); if(j.dev_code) pm.environment.set('otp',j.dev_code);"],"type":"text/javascript"}}]},
    {"name":"03 — Vérifier OTP","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"telephone\":\"{{telephone}}\",\"code\":\"{{otp}}\"}"},"url":"{{baseUrl}}/api/auth/verify-otp"},"event":[{"listen":"test","script":{"exec":["pm.test('Connexion réussie', () => pm.response.to.have.status(200));","pm.environment.set('token',pm.response.json().token);"],"type":"text/javascript"}}]},
    {"name":"04 — Compléter profil","request":{"method":"PATCH","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{token}}"}],"body":{"mode":"raw","raw":"{\"pseudo\":\"Awa\",\"quartier_defaut\":\"Mermoz\"}"},"url":"{{baseUrl}}/api/auth/profile"},"event":[{"listen":"test","script":{"exec":["pm.test('Profil enregistré', () => pm.response.to.have.status(200));"],"type":"text/javascript"}}]},
    {"name":"05 — Publier alerte","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{token}}"}],"body":{"mode":"raw","raw":"{\"categorie\":\"eau\",\"quartier\":\"Mermoz\",\"description\":\"Coupure d'eau depuis ce matin\",\"option_whatsapp\":true}"},"url":"{{baseUrl}}/api/alerts"},"event":[{"listen":"test","script":{"exec":["pm.test('Alerte créée', () => pm.response.to.have.status(201));","pm.environment.set('alertId',pm.response.json().id);"],"type":"text/javascript"}}]},
    {"name":"06 — Lire le fil","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/api/alerts?scope=quartier&categorie=eau"},"event":[{"listen":"test","script":{"exec":["pm.test('Fil reçu', () => pm.response.to.have.status(200));","pm.test('Liste non vide', () => pm.expect(pm.response.json().items.length).above(0));"],"type":"text/javascript"}}]},
    {"name":"07 — Résoudre alerte","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/api/alerts/{{alertId}}/resolve"},"event":[{"listen":"test","script":{"exec":["pm.test('Alerte résolue', () => pm.response.to.have.status(200));","pm.expect(pm.response.json().statut).to.eql('resolu');"],"type":"text/javascript"}}]}
  ]
}
